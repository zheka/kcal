{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "src/config.ts",
    "vite.config.ts",
    "vite.lab.config.ts",
    "pwa-assets.config.ts",
    "playwright.config.ts",
    "e2e",
    "scripts/*.ts"
  ]
}
